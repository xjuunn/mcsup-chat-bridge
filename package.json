{
  "name": "mcsup-chat-bridge",
  "version": "0.1.21",
  "private": true,
  "description": "MCSUP 聊天桥插件：Minecraft 聊天与控制台消息分发到可插拔平台，并支持 QQ 等平台消息回流游戏",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ensure:sdk": "node scripts/ensure-sdk.mjs",
    "pretypecheck": "node scripts/ensure-sdk.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "node scripts/ensure-sdk.mjs",
    "test": "vitest run",
    "prebuild": "node scripts/ensure-sdk.mjs",
    "build": "mcsup-plugin build --out build",
    "pretest:real": "node scripts/ensure-sdk.mjs",
    "test:real": "node scripts/real-host-check.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:real"
  },
  "dependencies": {
    "mcsup-plugin": "file:../mcsup/sdks/typescript",
    "ws": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
